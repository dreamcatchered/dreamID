[Unit]
Description=Auth SSO Service
After=network.target

[Service]
Type=simple
User=dream
WorkingDirectory=/home/dream/projects/auth
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-/home/dream/projects/auth/.env
ExecStart=/usr/bin/python3 /home/dream/projects/auth/app.py
Restart=always
RestartSec=5
LimitNOFILE=2048
LimitNPROC=512
MemoryMax=2G
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

